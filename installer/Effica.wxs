<Control Id="Description" Type="Text" X="15" Y="55" Width="340" Height="35" Transparent="yes" NoPrefix="yes" Text="Â¿Desea crear un acceso directo de Effica en la pantalla de inicio?" />
<Control Id="StartMenuCheckBox" Type="CheckBox" X="25" Y="110" Width="320" Height="18" Property="CREATE_START_MENU" CheckBoxValue="1" Text="Crear acceso directo en el menu Inicio" />
<Control Id="Back" Type="PushButton" X="220" Y="243" Width="56" Height="17" Text="Atras"><Publish Event="NewDialog" Value="InstallDirDlg" /></Control>
<Control Id="Next" Type="PushButton" X="280" Y="243" Width="56" Height="17" Default="yes" Text="Siguiente"><Publish Event="NewDialog" Value="VerifyReadyDlg" /></Control>
<Control Id="Cancel" Type="PushButton" X="320" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancelar"><Publish Event="SpawnDialog" Value="CancelDlg" /></Control>
</Dialog>
<Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="StartMenuDlg" Order="3" Condition="1" />
<Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="StartMenuDlg" Order="3" Condition="1" />
</UI>
<ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
<StandardDirectory Id="DesktopFolder"><Component Id="EfficaDesktopShortcut" Guid="51B62FE8-EBCF-44E6-81FC-406C86DDF223">
<Shortcut Id="EfficaShortcut" Name="Effica" Target="[INSTALLFOLDER]pospro.exe" WorkingDirectory="INSTALLFOLDER" Icon="EfficaIcon" />
<CreateFolder />
<RemoveFolder Id="RemoveEfficaShortcutFolder" On="uninstall" />
</Component></StandardDirectory>
<StandardDirectory Id="ProgramMenuFolder"><Directory Id="EFFICA_PROGRAMMENU" Name="Effica"><Component Id="EfficaStartMenuShortcut" Guid="1524B177-1A31-4ADE-9EEC-703027235721" Condition="CREATE_START_MENU">
<Shortcut Id="EfficaStartMenuShortcut" Name="Effica" Target="[INSTALLFOLDER]pospro.exe" WorkingDirectory="INSTALLFOLDER" Icon="EfficaIcon" />
